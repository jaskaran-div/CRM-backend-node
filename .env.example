DB_PASSWORD=ISFT-CRM@2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Must be identical to Spring's so existing tokens stay valid
JWT_SECRET='po3WGTcDP0Z14uulcl6SpAI6GMyixuMkr83jaYbIFsC'

# ---- Node-specific (crm-node.env)
HOST=127.0.0.1
# 8081 during the parallel run
PORT=8081
DB_POOL_MAX=5
# true ONLY after the Spring service has been stopped
SCHEDULER_ENABLED=false
# empty = same-origin via Nginx (production)
LOG_LEVEL=info
# Optional tuning:
# USER_CACHE_TTL_MS=30000
# LOGIN_RATE_LIMIT_PER_15MIN=20
# BCRYPT_COST=10
# DB_STATEMENT_TIMEOUT_MS=15000
