# Names only — never commit real values. Production values live in
# ~/.config/derivion/crm.env (shared with Spring) and ~/.config/derivion/crm-node.env (mode 600).
# systemd EnvironmentFile does not allow trailing comments: keep comments on their own lines.

# ---- shared with the Spring service (crm.env)
# jdbc:postgresql://host:port/db or postgres://...
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SUPABASE_SECRET_KEY=
# Must be identical to Spring's so existing tokens stay valid
JWT_SECRET=

# ---- Node-specific (crm-node.env)
HOST=127.0.0.1
# 8081 during the parallel run
PORT=8081
DB_POOL_MAX=5
# true ONLY after the Spring service has been stopped
SCHEDULER_ENABLED=false
# empty = same-origin via Nginx (production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
# Optional tuning:
# USER_CACHE_TTL_MS=30000
# LOGIN_RATE_LIMIT_PER_15MIN=20
# BCRYPT_COST=10
# DB_STATEMENT_TIMEOUT_MS=15000
