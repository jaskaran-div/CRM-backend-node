# Names only — never commit real values. Production values live in
# ~/.config/derivion/crm.env (shared with Spring) and ~/.config/derivion/crm-node.env (mode 600).
# systemd EnvironmentFile does not allow trailing comments: keep comments on their own lines.

# ---- shared with the Spring service (crm.env)
# jdbc:postgresql://host:port/db or postgres://...
DB_URL='jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres'
