# ~/.config/derivion/staging.env  (mode 600) — STAGING ONLY. Never put production values here.
# Generate secrets with:  openssl rand -base64 36
STAGING_PG_PORT=55433
STAGING_PG_PASSWORD=
# Password for the seeded synthetic accounts (admin@staging.test, manager@…, agent1@…, agent2@…)
STAGING_USER_PASSWORD=

# Node API (staging)
DB_URL=postgres://127.0.0.1:55433/crm_staging
DB_USERNAME=postgres
# Same value as STAGING_PG_PASSWORD
DB_PASSWORD=
DB_SSL=disable
DB_POOL_MAX=5
# Staging-only secret (different from production, so production tokens are rejected here)
JWT_SECRET=
HOST=127.0.0.1
PORT=8082
# Browser reaches the API via the SSH tunnel at http://localhost:8082
CORS_ORIGINS=http://localhost:3002
# Staging data only, so the scheduler is enabled to exercise the follow-up rules
SCHEDULER_ENABLED=true
LOG_LEVEL=info
NODE_ENV=production
